# Credentials. Never committed, under any name.
.env
.env.*
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Track B: the per-candidate result cache. Derived and keyed by
# (fingerprint, prompt config, backend, response schema) -- regenerating it
# costs API calls, but committing it would version answers that go stale the
# moment a prompt or the verdict schema changes. The *results* worth keeping
# are the run JSON files, which are committed.
.llm-cache/

# Run store (contract C3): runs are reproducible from the config and the
# manifest, and a run directory carries whole-program bitcode.
runs/

# In-progress run logs. Finished results are committed deliberately, by name.
*.log

# Claude Code local settings
.claude/
